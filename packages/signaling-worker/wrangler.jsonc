{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concord-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],

  // [2026-08-29] Full backend migration off AWS (decisions.md §0.2/§0.3) — this Worker now
  // serves REST (rest.ts, D1/R2-backed) alongside signaling (room.ts), not just signaling.

  // One RoomDurableObject instance per roomId (env.ROOMS.idFromName(roomId)) — the room's entire
  // live state (peers, host, epoch) is that instance. See src/room.ts for why. UPDATES is a
  // single singleton instance (idFromName('global')) — server->client "update available" push,
  // unrelated to any room, see src/updatesBroadcaster.ts.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "UPDATES", "class_name": "UpdatesBroadcaster" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["UpdatesBroadcaster"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concord",
      "database_id": "8627e987-8c86-4a24-91b0-73e22fe58f8a"
    }
  ],

  // [Resolvido 2026-08-29] R2 habilitado na conta pelo Mozar, bucket "concord-media" criado —
  // binding reativado.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "concord-media" }
  ],

  // Daily sweep for report/log TTL — D1 has no native expiry like DynamoDB (see src/index.ts's
  // scheduled() handler). Workers Free plan allows 5 Cron Triggers per account.
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  // [2026-08-30, pedido do Mozar] Logs de execução + traces no dashboard da Cloudflare
  // (Workers > concord-signaling > Observability). `enabled: false` no nível raiz é o toggle
  // "legado" (um interruptor só, logs+traces juntos) — deixado desligado de propósito porque
  // `logs`/`traces` abaixo já controlam cada um separadamente, forma mais nova recomendada pela
  // Cloudflare. `persist: true` nos dois é o que realmente manda o dado pro dashboard consultável;
  // sem isso, mesmo com `enabled: true`, nada fica gravado pra consulta depois.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // [2026-08-29, achado de segurança] Rate Limiting binding nativo do Workers (GA desde set/2025,
  // src/rateLimit.ts) — por IP (`CF-Connecting-IP`), período fixo de 60s (mínimo permitido além de
  // 10s). `namespace_id` só precisa ser único dentro deste Worker, não é um recurso criado à parte
  // (diferente de D1/R2/DO) — qualquer inteiro serve, escolhidos sequenciais aqui.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TURN_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOG_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "WS_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    { "name": "OAUTH_EXCHANGE_LIMITER", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ],

  // Secrets (never in this file — set via `wrangler secret put <NAME>`):
  //   SESSION_SECRET       — same HMAC key as packages/server's SESSION_SECRET, so a token issued
  //                          by either backend verifies against the other.
  //   TURN_KEY_ID           Cloudflare Realtime TURN key — optional, blank = client falls back
  //   TURN_API_TOKEN          to STUN-only (same as packages/server's TURN_KEY_ID/TURN_API_TOKEN).
  //   ADMIN_SECRET          Shared secret for POST /admin/notify-update (CI/manual trigger of the
  //                          update-available broadcast, src/updatesBroadcaster.ts) — new secret,
  //                          not tied to any existing credential.
  //   GOOGLE_OAUTH_CLIENT_SECRET — moved here from packages/client/.env (2026-08-29, auditoria de
  //                          segurança) — token exchange with Google now happens server-side
  //                          (rest.ts's handleGoogleExchange), so this never needs to leave the
  //                          Worker again.
  //
  // [2026-08-29] R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY (usados só por src/r2.ts, presigned
  // upload/download pro client) e as vars CF_ACCOUNT_ID/R2_BUCKET_NAME (existiam só pra montar a
  // URL do objeto em r2.ts) foram removidos daqui junto com o arquivo — /uploads/presign era
  // achado de segurança (ALTO, sem rate limit/tamanho máximo) e código morto ao mesmo tempo
  // (avatar/ícone de servidor são 100% P2P/cache local, nunca chamavam esse endpoint de verdade).
  // Os dois secrets de R2 foram apagados de verdade (`wrangler secret delete`), não só daqui.
  "vars": {
    // Mirrors packages/server/.env — same "never true in production" rule.
    "ALLOW_UNAUTHENTICATED_ROOMS": "false",
    // [2026-08-29] Público por natureza (OAuth client_id, não client_secret — vai no `aud` do
    // id_token) — mesmo valor de packages/client/.env, usado para validar login no servidor
    // (src/googleAuth.ts). Não é segredo, por isso var e não `wrangler secret put`.
    "GOOGLE_OAUTH_CLIENT_ID": "330694094519-pkclq22u953hd39ddru698459l05qsst.apps.googleusercontent.com"
  }
}
