# Copy to .dev.vars (gitignored) for `wrangler dev`. In production these are `wrangler secret put`
# values instead — never committed, never put in wrangler.jsonc.

# HMAC key for session tokens (auth.ts).
SESSION_SECRET=

# Cloudflare Realtime TURN key (Dashboard: Calls > TURN Keys) — optional, blank = client falls
# back to STUN-only.
TURN_KEY_ID=
TURN_API_TOKEN=

# Shared secret for POST /admin/notify-update (server-push "update available" broadcast) — also
# what scripts/publish-update.sh reads from here to notify already-open clients automatically.
ADMIN_SECRET=

# Cloudflare Realtime SFU app (Dashboard: Realtime > SFU) — optional, blank = every room stays mesh.
REALTIME_SFU_APP_ID=
REALTIME_SFU_APP_SECRET=

# Local testing only: 'sfu' or 'mesh' forces that media mode for every room (ignores each server's
# servers.media_mode, which the fake test-dev servers don't have). Leave unset otherwise.
# MEDIA_MODE_OVERRIDE=sfu

# Google OAuth client secret — token exchange happens server-side now (rest.ts's
# handleGoogleExchange), see decisions.md's security-audit section for why this moved here from
# packages/client/.env.
GOOGLE_OAUTH_CLIENT_SECRET=
