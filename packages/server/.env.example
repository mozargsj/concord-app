SIGNALING_PORT=8080

# No static AWS keys here — credentials come from the EC2 instance role
# (concord-signaling-role) via the SDK's default provider chain.
AWS_REGION=sa-east-1

DYNAMODB_TABLE_PREFIX=concord_
S3_SERVER_ICONS_BUCKET=concord-server-icons

# HMAC key used to sign/verify our own session tokens (jose, HS256) — not a Google credential.
# Generate a real random value locally (e.g. `openssl rand -base64 48`) and never commit it.
SESSION_SECRET=

# Lets join-room (roomManager.ts) accept a room without a real session/membership check, falling
# back to whatever userId the client claims. Only exists so the client's TEST_MODE (api.ts — fake
# login/server/room, no real backend account) can still exercise the real signaling/WebRTC mesh.
# NEVER set this to true on the production signaling server.
ALLOW_UNAUTHENTICATED_ROOMS=false

# Cloudflare Realtime TURN key (Dashboard/API: Calls > TURN Keys) — lets the server mint
# short-lived TURN credentials for the client (GET /webrtc/turn-credentials) as a NAT-traversal
# fallback for peers that can't reach each other directly via STUN alone. Both blank by default:
# the endpoint reports "not configured" and the client just keeps using STUN-only.
TURN_KEY_ID=
TURN_API_TOKEN=
