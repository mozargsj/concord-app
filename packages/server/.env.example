SIGNALING_PORT=8080

# AWS credentials — leave unset until decided (access key pair, profile, or IAM role).
# The DynamoDB/S3 clients in src/aws/ only read these when a request is actually made,
# so the server boots fine without them; you just can't hit AWS-backed routes yet.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DYNAMODB_TABLE_PREFIX=concord_
S3_SERVER_ICONS_BUCKET=
