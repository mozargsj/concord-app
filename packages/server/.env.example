SIGNALING_PORT=8080

# No static AWS keys here — credentials come from the EC2 instance role
# (concord-signaling-role) via the SDK's default provider chain.
AWS_REGION=sa-east-1

DYNAMODB_TABLE_PREFIX=concord_
S3_SERVER_ICONS_BUCKET=concord-server-icons

# HMAC key used to sign/verify our own session tokens (jose, HS256) — not a Google credential.
# Generate a real random value locally (e.g. `openssl rand -base64 48`) and never commit it.
SESSION_SECRET=
