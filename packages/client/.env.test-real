# [MODO TESTE — TEMPORÁRIO] Perfil "real" — diferente de test-dev, login/conta/
# servidor/sala são REAIS (Google OAuth de verdade, API REST/DynamoDB de verdade), só que
# apontando pro signaling local em vez da AWS de produção. Serve pra validar o fluxo completo
# (login, DB, mesh WebRTC) contra um ambiente sem custo, antes de reconectar na AWS real.
#
# Build: npm run package:test-real (packages/client/package.json)
#
# Requer, na mesma máquina que roda `npm run dev:server`: DynamoDB Local no ar (porta 8000,
# ver packages/server/.env) e um Cloudflare Tunnel nomeado expondo o servidor local na URL
# abaixo (`cloudflared tunnel run concord-local-test`) — sem isso, testadores remotos não
# alcançam o signaling.
VITE_SIGNALING_URL=wss://test-local.undersoft.tec.br

VITE_TEST_MODE=false
