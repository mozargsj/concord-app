VITE_SIGNALING_URL=wss://signaling.undersoft.tec.br

# [MODO TESTE — TEMPORÁRIO] Ver lib/api.ts. Fica false por padrão — um checkout novo já nasce
# no fluxo real (Google OAuth). Só ligar localmente pra testar sem depender do backend/AWS.
VITE_TEST_MODE=false

# Lidas só pelo processo main (dotenv) — nunca prefixar com VITE_. Cadastre um client OAuth
# tipo "Desktop app" no Google Cloud Console e cole os valores reais só no .env (não aqui).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
