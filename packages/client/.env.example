VITE_SIGNALING_URL=wss://signaling.undersoft.tec.br

# [MODO TESTE — TEMPORÁRIO] Ver lib/api.ts. Fica false por padrão — um checkout novo já nasce
# no fluxo real (Google OAuth). Só ligar localmente pra testar sem depender do backend/AWS.
VITE_TEST_MODE=false

# Lida só pelo processo main (dotenv) — nunca prefixar com VITE_. Cadastre um client OAuth tipo
# "Desktop app" no Google Cloud Console e cole o client_id real só no .env (não aqui).
# [2026-08-29] client_secret NÃO fica mais aqui — movido pro Worker (wrangler secret put
# GOOGLE_OAUTH_CLIENT_SECRET), que agora faz a troca de code por tokens (rest.ts's
# handleGoogleExchange). Nenhum instalador distribuído carrega mais esse valor.
GOOGLE_OAUTH_CLIENT_ID=
