{
  "name": "@concord/client",
  "private": true,
  "version": "0.0.98",
  "description": "Concord — app P2P de áudio ao vivo e transmissão de tela, estilo Discord",
  "author": "Mozar",
  "main": "out/electron/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:renderer:test-dev": "vite --mode test-dev",
    "dev:renderer:test-real": "vite --mode test-real",
    "dev:electron": "tsc -p tsconfig.electron.json && electron out/electron/main/index.js",
    "dev": "concurrently -k -n renderer,electron -c blue,green \"npm:dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:test-dev": "concurrently -k -n renderer,electron -c blue,green \"npm:dev:renderer:test-dev\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:test-real": "concurrently -k -n renderer,electron -c blue,green \"npm:dev:renderer:test-real\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:renderer:test-dev": "vite build --mode test-dev",
    "build:renderer:test-real": "vite build --mode test-real",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "build:test-dev": "npm run build:renderer:test-dev && npm run build:electron",
    "build:test-real": "npm run build:renderer:test-real && npm run build:electron",
    "package": "npm run build && electron-builder",
    "package:test-dev": "npm run build:test-dev && electron-builder --config.productName=ConcordTest --config.appId=com.concord.app.test",
    "package:test-real": "npm run build:test-real && electron-builder --config.productName=ConcordTestReal --config.appId=com.concord.app.test-real --config.publish.url=https://test-local.undersoft.tec.br/updates/",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:native": "node native/process-loopback/build.js && node native/input-control/build.js"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "jose": "^5.9.6",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@concord/shared": "0.0.1",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^11.5.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
