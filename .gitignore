node_modules/
dist/
out/
# packages/client/build/ is electron-builder's source-asset folder (app icon.ico), not build
# output — a blanket `build/` rule here was silently excluding it from every commit (git can't
# un-ignore files inside an already-ignored directory, so a negation pattern doesn't work either),
# so CI checkouts never had a real icon.ico and electron-builder fell back to Electron's generic
# icon. It's the only directory anywhere in the repo actually named "build", so just not ignoring
# it at all is simplest.
release/
tools/
# node-gyp build output for the process-loopback native addon (compiled .node binary, MSVC
# project files) — regenerated by `npm run build:native`, never hand-edited. Scoped to this exact
# path, not a blanket `build/` rule — see the packages/client/build/ note above for why that bit
# us once already.
packages/client/native/process-loopback/build/
packages/server/updates/
.claude/
*.log
.env
.env.*
!.env.example
!.env.test-dev
!.env.test-offline
!.env.test-real
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
